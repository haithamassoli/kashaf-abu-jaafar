{
  "name": "kashaf-abu-jaafar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "meili": "meilisearch --db-path ./data/meili/data.ms --master-key $MEILI_ADMIN_KEY --http-addr 127.0.0.1:7700 --env development",
    "data": "tsx scripts/build-data.ts",
    "index": "tsx scripts/index.ts",
    "ingest": "pnpm data && pnpm index",
    "deploy": "wrangler pages deploy dist",
    "check": "tsx scripts/selfcheck.ts",
    "predeploy": "! grep -rql '127.0.0.1:7700' dist || (echo 'PUBLIC_MEILI_HOST is still localhost — set the public one and rebuild' && false)"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.1.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.2.0",
    "chart.js": "^4.5.1",
    "meilisearch": "^0.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
