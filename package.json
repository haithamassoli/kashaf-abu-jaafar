{
  "name": "kashaf-abu-jaafar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "meili": "meilisearch --db-path ./data/meili/data.ms --master-key $MEILI_ADMIN_KEY --http-addr 127.0.0.1:7700 --env development",
    "data": "tsx --env-file-if-exists=.env scripts/build-data.ts",
    "articles": "tsx scripts/articles.ts",
    "telegram": "tsx scripts/telegram.ts",
    "index": "tsx --env-file-if-exists=.env scripts/index.ts",
    "embed": "tsx --env-file-if-exists=.env scripts/embed.ts",
    "ingest": "pnpm data && pnpm articles && pnpm telegram && pnpm index",
    "deploy": "wrangler pages deploy dist",
    "check": "tsx scripts/selfcheck.ts",
    "verify": "tsx --env-file-if-exists=.env scripts/verify-batch.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "predeploy": "! grep -rql '127.0.0.1:7700' dist || (echo 'PUBLIC_MEILI_HOST is still localhost — set the public one and rebuild' && false)"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.2.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "meilisearch": "^0.60.0",
    "posthog-js": "^1.418.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
