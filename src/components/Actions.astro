---
/**
 * Bookmark / share / save-as-PDF / download-as-TXT, for a lesson, article or playlist.
 *
 * PDF is the browser's own print-to-PDF (see the @media print block in global.css) —
 * no PDF library ships to the reader, and it prints Arabic shaping correctly, which
 * is more than most of them manage. The .txt body is scraped from the page's own DOM:
 * a transcript is ~1,400 rows already in the HTML, and repeating it in a data
 * attribute would double the page for a button most readers never press.
 *
 * The bookmark is localStorage only (lib/store.ts) — there are no accounts.
 */
import type { Kind } from '../lib/store'

const {
  title,
  kind,
  class: cls,
} = Astro.props as { title: string; kind: Kind; class?: string }

// One list rendered twice: a row of buttons from sm up, a single menu below it. The
// icons are raw <svg> bodies so both renderings share them instead of duplicating 3 KB.
const ACTS = [
  {
    act: 'share',
    label: 'مشاركة',
    icon: `<circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"></path>`,
  },
  {
    act: 'copy',
    label: 'نسخ الكل',
    icon: `<rect x="8" y="8" width="14" height="14" rx="2"></rect><path d="M4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"></path>`,
  },
  {
    act: 'pdf',
    label: 'PDF',
    icon: `<path d="M6 9V3h12v6M6 18H4v-6h16v6h-2"></path><rect x="8" y="15" width="8" height="6" rx="1"></rect>`,
  },
  {
    act: 'txt',
    label: 'TXT',
    icon: `<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h6"></path>`,
  },
]

// A playlist page has no prose: there is nothing to copy or download, and its print is
// just the lesson list. Only sharing survives, and one button needs no menu.
const acts = kind === 'p' ? ACTS.filter((a) => a.act === 'share') : ACTS
const menu = acts.length > 1

const svg = 'size-4 shrink-0'
const btn =
  'inline-flex min-h-11 items-center gap-2 rounded-lg border border-border bg-surface px-3 text-sm text-muted transition-colors hover:text-fg'
const item =
  'flex min-h-11 w-full items-center gap-2 px-3 text-start text-sm text-muted transition-colors hover:bg-surface-2 hover:text-fg'
---

<div
  data-actions
  data-title={title}
  data-kind={kind}
  class:list={['flex items-center gap-2 print:hidden', cls]}
>
  {/* Starts unpressed and is corrected on hydration: the page is a static file, so
      the saved state cannot be known until localStorage is read in the browser. */}
  <button
    type="button"
    data-mark
    aria-pressed="false"
    aria-label="احفظ في المحفوظات"
    title="احفظ في المحفوظات"
    class:list={[
      'grid size-11 shrink-0 place-items-center rounded-lg border border-border bg-surface text-muted transition-colors hover:text-fg',
      "aria-pressed:text-accent aria-pressed:[&_svg]:fill-current",
    ]}
  >
    <svg
      class="size-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>

  <div class:list={['flex-wrap items-center gap-2', menu ? 'hidden sm:flex' : 'flex']}>
    {
      acts.map((a) => (
        <button type="button" data-act={a.act} class={btn}>
          <svg
            class={svg}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={a.icon}
          />
          {a.label}
        </button>
      ))
    }
  </div>

  {/* ponytail: <details> is the whole mobile menu — native disclosure, no island, no
      dependency. The two lines of JS below are the only things it lacks: click-outside
      and Escape. Swap for a Base UI Menu only if it ever needs arrow-key roving. */}
  {
    menu && (
      <details data-menu class="relative sm:hidden">
        <summary class:list={[btn, 'cursor-pointer list-none [&::-webkit-details-marker]:hidden']}>
          <svg
            class={svg}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="5" cy="12" r="1.4" fill="currentColor" />
            <circle cx="12" cy="12" r="1.4" fill="currentColor" />
            <circle cx="19" cy="12" r="1.4" fill="currentColor" />
          </svg>
          خيارات
        </summary>

        <div class="absolute end-0 z-30 mt-2 w-44 overflow-hidden rounded-lg border border-border bg-surface py-1 shadow-lg">
          {acts.map((a) => (
            <button type="button" data-act={a.act} class={item}>
              <svg
                class={svg}
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={a.icon}
              />
              {a.label}
            </button>
          ))}
        </div>
      </details>
    )
  }
</div>

<script>
  import { flash } from '../lib/toast'
  import { all, update, type Kind } from '../lib/store'

  const bar = document.querySelector<HTMLElement>('[data-actions]')
  if (bar) {
    const title = bar.dataset.title || document.title
    const kind = (bar.dataset.kind || 'v') as Kind
    const path = location.pathname
    const menu = bar.querySelector<HTMLDetailsElement>('[data-menu]')

    /** Transcript cues on a lesson page, article paragraphs everywhere else. */
    const body = () => {
      const cues = document.querySelectorAll<HTMLLIElement>('#cues > li')
      if (cues.length)
        return Array.from(
          cues,
          (li) => `[${li.querySelector('.cue-ts')?.textContent?.trim()}] ${li.querySelector('.cue-txt')?.textContent?.trim()}`,
        ).join('\n')
      return Array.from(document.querySelectorAll('.prose-naskh p'), (p) =>
        p.textContent?.trim(),
      ).join('\n\n')
    }

    // Deliberately ignores the in-page filter: here, on the clipboard and in print,
    // "the whole page" means the whole text, not whatever is typed in the search box.
    // The title and the link lead it so a pasted lesson says where it came from.
    const doc = () => `${title}\n${location.origin}${location.pathname}\n\n${body()}\n`

    const copy = async () => {
      try {
        await navigator.clipboard.writeText(doc())
        flash('تم نسخ النص')
      } catch {
        flash('تعذّر النسخ')
      }
    }

    const txt = () => {
      const url = URL.createObjectURL(
        new Blob([doc()], {
          type: 'text/plain;charset=utf-8',
        }),
      )
      const a = Object.assign(document.createElement('a'), {
        href: url,
        // Arabic filenames are fine; only the characters filesystems reject are stripped.
        download: `${title.replace(/[\\/:*?"<>|]/g, '-').slice(0, 80)}.txt`,
      })
      a.click()
      URL.revokeObjectURL(url)
    }

    const share = async () => {
      try {
        if (navigator.share) return await navigator.share({ title, url: location.href })
        await navigator.clipboard.writeText(location.href)
        flash('تم نسخ الرابط')
      } catch (e) {
        // Dismissing the share sheet rejects with AbortError — that is not a failure.
        if ((e as Error).name !== 'AbortError') flash('تعذّرت المشاركة')
      }
    }

    const markBtn = bar.querySelector<HTMLButtonElement>('[data-mark]')
    const paint = (on: boolean) => {
      markBtn?.setAttribute('aria-pressed', String(on))
      const label = on ? 'أزل من المحفوظات' : 'احفظ في المحفوظات'
      markBtn?.setAttribute('aria-label', label)
      markBtn?.setAttribute('title', label)
    }
    paint(!!all()[path]?.mark)

    markBtn?.addEventListener('click', () => {
      const on = markBtn.getAttribute('aria-pressed') !== 'true'
      update(path, { title, kind }, { mark: on || undefined })
      paint(on)
      flash(on ? 'أُضيف إلى المحفوظات' : 'أُزيل من المحفوظات')
    })

    bar.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act
      if (!act) return
      if (menu) menu.open = false
      if (act === 'share') share()
      else if (act === 'copy') copy()
      else if (act === 'pdf') print()
      else if (act === 'txt') txt()
    })

    if (menu) {
      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('[data-menu]')) menu.open = false
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') menu.open = false
      })
    }
  }
</script>
