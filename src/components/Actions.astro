---
/**
 * Share / save-as-PDF / download-as-TXT, for a lesson or an article page.
 *
 * PDF is the browser's own print-to-PDF (see the @media print block in global.css) —
 * no PDF library ships to the reader, and it prints Arabic shaping correctly, which
 * is more than most of them manage. The .txt body is scraped from the page's own DOM:
 * a transcript is ~1,400 rows already in the HTML, and repeating it in a data
 * attribute would double the page for a button most readers never press.
 */
const btn =
  'inline-flex min-h-11 items-center gap-2 rounded-lg border border-border bg-surface px-3 text-sm text-muted transition-colors hover:text-fg'
const { title } = Astro.props as { title: string }
---

<div data-actions data-title={title} class="mt-4 flex flex-wrap items-center gap-2 print:hidden">
  <button type="button" data-act="share" class={btn}>
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle>
      <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"></path>
    </svg>
    مشاركة
  </button>

  <button type="button" data-act="pdf" class={btn}>
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9V3h12v6M6 18H4v-6h16v6h-2"></path><rect x="8" y="15" width="8" height="6" rx="1"></rect>
    </svg>
    PDF
  </button>

  <button type="button" data-act="txt" class={btn}>
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
      <path d="M14 3v5h5M9 13h6M9 17h6"></path>
    </svg>
    TXT
  </button>
</div>

<script>
  import { flash } from '../lib/toast'

  const bar = document.querySelector<HTMLElement>('[data-actions]')
  if (bar) {
    const title = bar.dataset.title || document.title

    /** Transcript cues on a lesson page, article paragraphs everywhere else. */
    const body = () => {
      const cues = document.querySelectorAll<HTMLLIElement>('#cues > li')
      if (cues.length)
        return Array.from(
          cues,
          (li) => `[${li.querySelector('.cue-ts')?.textContent?.trim()}] ${li.querySelector('.cue-txt')?.textContent?.trim()}`,
        ).join('\n')
      return Array.from(document.querySelectorAll('.prose-naskh p'), (p) =>
        p.textContent?.trim(),
      ).join('\n\n')
    }

    // Deliberately ignores the in-page filter: both here and in print, "download this
    // page" means the whole text, not whatever happens to be typed in the search box.
    const txt = () => {
      const url = URL.createObjectURL(
        new Blob([`${title}\n${location.origin}${location.pathname}\n\n${body()}\n`], {
          type: 'text/plain;charset=utf-8',
        }),
      )
      const a = Object.assign(document.createElement('a'), {
        href: url,
        // Arabic filenames are fine; only the characters filesystems reject are stripped.
        download: `${title.replace(/[\\/:*?"<>|]/g, '-').slice(0, 80)}.txt`,
      })
      a.click()
      URL.revokeObjectURL(url)
    }

    const share = async () => {
      try {
        if (navigator.share) return await navigator.share({ title, url: location.href })
        await navigator.clipboard.writeText(location.href)
        flash('تم نسخ الرابط')
      } catch (e) {
        // Dismissing the share sheet rejects with AbortError — that is not a failure.
        if ((e as Error).name !== 'AbortError') flash('تعذّرت المشاركة')
      }
    }

    bar.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act
      if (act === 'share') share()
      else if (act === 'pdf') print()
      else if (act === 'txt') txt()
    })
  }
</script>
