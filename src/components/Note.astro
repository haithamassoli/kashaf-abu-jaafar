---
/**
 * The reader's private note for this page. localStorage only (lib/store.ts) — there
 * are no accounts, so the note lives on the device that wrote it and nowhere else.
 * ponytail: a plain <textarea> in a native <details>, autosaved. No editor, no
 * markdown, no per-cue notes — add those only if someone actually asks.
 */
import type { Kind } from '../lib/store'

const { title, kind } = Astro.props as { title: string; kind: Kind }
---

<details data-note data-title={title} data-kind={kind} class="mt-8 print:hidden">
  <summary
    class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg border border-border bg-surface px-3 text-sm text-muted transition-colors hover:text-fg [&::-webkit-details-marker]:hidden"
  >
    <svg
      class="size-4 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
    </svg>
    ملاحظاتي
  </summary>

  <label for="note-input" class="sr-only">ملاحظاتي على هذه الصفحة</label>
  {/* No `text-base`/`leading-loose`: those override prose-naskh and the reader ends up
      writing at 16/32 next to an article set in 17/34. Left alone, the note is the same
      type as the page it sits under, in a panel the same shape as .card.
      field-sizing keeps the box growing past `min-h` as the note gets longer; `rows` is
      the fallback where it isn't supported, and the cap keeps it on screen. */}
  <textarea
    id="note-input"
    data-note-input
    rows="5"
    placeholder="اكتب ملاحظتك هنا…"
    class="prose-naskh mt-2 max-h-[60dvh] min-h-52 w-full resize-y rounded-xl border border-border-strong bg-surface p-4 field-sizing-content placeholder:text-muted"
  ></textarea>
  <p data-note-state aria-live="polite" class="min-h-5 text-xs text-muted"></p>
</details>

<script>
  import { all, update, type Kind } from '../lib/store'

  const box = document.querySelector<HTMLDetailsElement>('[data-note]')
  const input = box?.querySelector<HTMLTextAreaElement>('[data-note-input]')
  const state = box?.querySelector<HTMLElement>('[data-note-state]')

  if (box && input && state) {
    const title = box.dataset.title || document.title
    const kind = (box.dataset.kind || 'v') as Kind
    const path = location.pathname

    const saved = all()[path]?.note ?? ''
    input.value = saved
    // Open only for a note that already exists — otherwise the panel is noise on a
    // page the reader has never annotated.
    box.open = !!saved

    // ponytail: 500 ms debounce and no beforeunload flush. Worst case a reader loses
    // the last half-second of typing by closing the tab mid-word.
    let timer: ReturnType<typeof setTimeout>
    input.addEventListener('input', () => {
      clearTimeout(timer)
      state.textContent = ''
      timer = setTimeout(() => {
        const text = input.value.trim()
        update(path, { title, kind }, { note: text || undefined })
        state.textContent = text ? 'حُفظت' : 'حُذفت الملاحظة'
      }, 500)
    })
  }
</script>
