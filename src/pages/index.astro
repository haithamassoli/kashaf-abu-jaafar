---
import Base from '../layouts/Base.astro'
import Search from '../islands/Search.tsx'
import Charts from '../components/Charts.astro'
import { playlists, totalHours, videos } from '../lib/data'
import { arabicDate, withDigits } from '../lib/format'
import { SITE, SITE_URL, SHEIKH, person } from '../lib/seo'

const options = playlists.map((p) => ({ id: p.id, title: p.title, count: p.videoIds.length }))

const num = (n: number) => n.toLocaleString('en-US')
const cues = videos.reduce((n, v) => n + v.segmentCount, 0)
const lastUpload = videos.map((v) => v.uploadDate ?? '').sort().at(-1)

// ponytail: المقالات has no ingest yet (alkulify.com has been 522 since ~2026-07),
// so the card says قريبًا; swap in a count when scripts/ starts writing data/articles.
const cards = [
  {
    label: 'الدروس',
    value: num(videos.length),
    icon: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18', 'm10.3 8.5 5.2 3.5-5.2 3.5Z'],
  },
  {
    label: 'قوائم التشغيل',
    value: num(playlists.length),
    icon: ['M4 7h12M4 12h12M4 17h7', 'm17 13 4 2.5-4 2.5Z'],
  },
  {
    label: 'الساعات المفرَّغة',
    value: num(Math.round(totalHours)),
    icon: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18', 'M12 7.5V12l3 2'],
  },
  {
    label: 'المقاطع المفهرسة',
    value: num(cues),
    icon: ['M20 15a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2Z', 'M8 9h8M8 13h5'],
  },
  {
    label: 'المقالات',
    value: 'قريبًا',
    icon: ['M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z', 'M14 3v5h5', 'M9 13h6M9 17h4'],
  },
  {
    label: 'آخر إضافة',
    value: arabicDate(lastUpload),
    icon: ['M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z', 'M8 3v4M16 3v4M4 11h16'],
  },
]

// ?q= is a real, shareable URL (Search.tsx keeps state there), so the SearchAction is honest.
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE,
      description: `فهرس بحث في نصوص دروس ${SHEIKH} المفرَّغة آليًا.`,
      inLanguage: 'ar',
      about: { '@id': person['@id'] },
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${SITE_URL}/?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    person,
  ],
}

// Whole-number values stay LTR as one run; Arabic ones only isolate their digits.
const value = (s: string) => (/^[\d,]+$/.test(s) ? `<span class="digits">${s}</span>` : withDigits(s))
---

<Base
  description="ابحث في نصوص دروس الشيخ أبي جعفر عبد الله بن فهد الخليفي المفرَّغة آليًا."
  schema={[siteSchema]}
>
  <section class="pt-10 sm:pt-16">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">كشّاف أبي جعفر</h1>
    <p class="mt-3 text-muted">ابحث في دروس الشيخ أبي جعفر عبد الله بن فهد الخليفي</p>
  </section>

  <Search client:load playlists={options} />

  <section id="platform-content" class="mt-14 border-t border-border pt-10">
    <h2 class="text-lg font-semibold tracking-tight">محتوى المنصة</h2>
    <p class="mt-2 text-sm text-muted">ما هو متاح في الكشّاف حتى الآن</p>

    <ul class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3">
      {
        cards.map((c) => (
          <li class="card flex items-center justify-between gap-3 px-4 py-4">
            <div class="min-w-0">
              <span class="block text-sm text-muted">{c.label}</span>
              <span class="mt-1 block text-xl font-semibold" set:html={value(c.value)} />
            </div>
            <svg
              class="size-5 shrink-0 text-muted"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {c.icon.map((d) => (
                <path d={d} />
              ))}
            </svg>
          </li>
        ))
      }
    </ul>

    <Charts />
  </section>
</Base>
