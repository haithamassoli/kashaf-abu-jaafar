---
import Base from '../../layouts/Base.astro'
import Actions from '../../components/Actions.astro'
import Note from '../../components/Note.astro'
import { allArticles, type Article } from '../../lib/data'
import { arabicDate } from '../../lib/format'
import { SITE, SITE_URL, person, breadcrumb } from '../../lib/seo'

export function getStaticPaths() {
  return allArticles().map((article) => ({ params: { id: article.id }, props: { article } }))
}

interface Props {
  article: Article
}

const { article } = Astro.props

const LABEL: Record<string, string> = { post: 'مقالة', fatwa: 'فتوى', book: 'كتاب' }
const kind = LABEL[article.type] ?? 'مقالة'

const intro = article.paragraphs[0] ?? ''
const description = intro.length > 150 ? `${intro.slice(0, 150).trimEnd()}…` : intro

// The WordPress origin has been 522 for months, so its own URL is a dead end for now —
// the archived copy we ingested from is the link that actually opens.
const archive = article.source === 'wp' ? `https://web.archive.org/web/${article.url}` : null

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${SITE_URL}/a/${article.id}/#article`,
  headline: article.title,
  description: description || undefined,
  datePublished: article.date ?? undefined,
  dateModified: article.modified ?? undefined,
  articleSection: article.categories.length ? article.categories : undefined,
  image: article.images?.length
    ? article.images.map((i) => new URL(i.src, SITE_URL).href)
    : undefined,
  url: new URL(`/a/${article.id}/`, SITE_URL).href,
  mainEntityOfPage: new URL(`/a/${article.id}/`, SITE_URL).href,
  isBasedOn: article.url,
  inLanguage: 'ar',
  author: person,
}

const crumbs = breadcrumb([[article.title, `/a/${article.id}/`]])
---

<Base
  title={article.title}
  description={description || undefined}
  schema={[articleSchema, crumbs]}
>
  <article class="pt-8">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-surface-2 px-3 py-1 text-xs text-muted">{kind}</span>
      {
        article.categories.map((c) => (
          <span class="rounded-full bg-surface-2 px-3 py-1 text-xs text-muted">{c}</span>
        ))
      }
    </div>

    <h1 class="mt-4 text-xl font-semibold leading-relaxed sm:text-2xl">{article.title}</h1>

    <div class="mt-1 flex flex-wrap items-center gap-x-5 text-sm text-muted">
      {article.date && <bdi>{arabicDate(article.date)}</bdi>}
      <a
        href={article.url}
        rel="noopener nofollow"
        class="inline-flex min-h-11 items-center text-accent underline underline-offset-4">المصدر</a
      >
      {
        archive && (
          <a
            href={archive}
            rel="noopener nofollow"
            class="inline-flex min-h-11 items-center text-accent underline underline-offset-4"
          >
            نسخة الأرشيف
          </a>
        )
      }
      {/* Print drops the chrome, so paper needs the way back to the page it came from. */}
      <a
        href={`${SITE_URL}/a/${article.id}/`}
        class="hidden min-h-11 items-center text-accent underline underline-offset-4 print:inline-flex"
        >افتح في {SITE}</a
      >
    </div>

    <Actions title={article.title} kind="a" class="mt-4" />

    <svg hidden aria-hidden="true">
      <symbol id="i-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="8" y="8" width="14" height="14" rx="2"></rect>
        <path d="M4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"></path>
      </symbol>
    </svg>

    <div class="prose-naskh mt-6 max-w-none space-y-4 text-fg">
      {
        /* Telegram posts are written *about* the screenshot above them — «الصورة في الأعلى» —
           so it leads the body, and it is not decorative. There is no caption to use as alt. */
        article.images?.map((img) => (
          <img
            src={img.src}
            width={img.w}
            height={img.h}
            alt="صورة مرفقة بالمنشور"
            loading="lazy"
            decoding="async"
            class="mx-auto max-w-full rounded-xl border border-border"
          />
        ))
      }
      {
        /* The paragraph keeps its own id so /a/<id>#p<n> and `p:target` still land on it;
           the wrapper only exists to hang the hover-revealed copy button off. */
        article.paragraphs.map((p, n) => (
          <div class="group flex items-start gap-2">
            <p id={`p${n}`} class="min-w-0 flex-1 scroll-mt-20">
              {p}
            </p>
            <button type="button" data-copy class="cue-copy" aria-label={`انسخ نص الفقرة ${n + 1}`}>
              <svg class="size-4" aria-hidden="true">
                <use href="#i-copy" />
              </svg>
            </button>
          </div>
        ))
      }
    </div>

    <Note title={article.title} kind="a" />
  </article>
</Base>

<script>
  import { flash } from '../../lib/toast'

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-copy]')
    if (!btn) return
    try {
      await navigator.clipboard.writeText(
        btn.parentElement?.querySelector('p')?.textContent?.trim() ?? '',
      )
      flash('تم نسخ النص')
    } catch {
      flash('تعذّر النسخ')
    }
  })
</script>
