---
import Base from '../../layouts/Base.astro'
import Actions from '../../components/Actions.astro'
import {
  contentDigest,
  playlists,
  playlistVideos,
  playlistDuration,
  videoById,
  type Playlist,
} from '../../lib/data'
import { arabicDate, duration, lessons, withDigits } from '../../lib/format'
import { SITE_URL, SHEIKH, breadcrumb } from '../../lib/seo'

export function getStaticPaths() {
  return playlists.map((playlist) => ({
    params: { id: playlist.id },
    props: { playlist },
    cacheKey: contentDigest(playlist, playlist.videoIds.map((id) => videoById.get(id))),
  }))
}

type Props = { playlist: Playlist }

const { playlist } = Astro.props
const videos = playlistVideos(playlist) // oldest lesson first; the ItemList below follows suit

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}/p/${playlist.id}/#collection`,
  name: playlist.title,
  inLanguage: 'ar',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: videos.length,
    itemListElement: videos.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/v/${v.id}/`, SITE_URL).href,
      name: v.title,
    })),
  },
}

const crumbs = breadcrumb([['القوائم', '/p/'], [playlist.title, `/p/${playlist.id}/`]])

---

<Base
  title={playlist.title}
  description={`${playlist.title} — ${lessons(videos.length)} من دروس ${SHEIKH}`}
  schema={[listSchema, crumbs]}
>
  <p class="mt-8 text-sm">
    <a href="/p/" class="text-muted underline underline-offset-4 hover:text-fg">القوائم</a>
  </p>

  <div class="mt-3 flex items-start gap-3">
    <h1 class="min-w-0 flex-1 text-2xl font-semibold tracking-tight sm:text-3xl">{playlist.title}</h1>
    <Actions title={playlist.title} kind="p" class="shrink-0" />
  </div>

  <p class="mt-2 text-sm text-muted">
    <span set:html={withDigits(`${lessons(videos.length)} · ${duration(playlistDuration(playlist))}`)} />
  </p>

  <form action="/" method="get" role="search" class="mt-6 flex gap-2">
    <label for="scoped-search" class="sr-only">ابحث داخل هذه القائمة</label>
    <input
      id="scoped-search"
      name="q"
      type="search"
      data-search-input
      required
      autocomplete="off"
      placeholder="ابحث داخل هذه القائمة"
      class="min-w-0 flex-1 rounded-xl border border-border-strong bg-surface px-4 py-3 text-base placeholder:text-muted"
    />
    <input type="hidden" name="pl" value={playlist.id} />
    <button
      type="submit"
      class="rounded-xl bg-accent px-5 py-3 font-medium text-accent-fg transition-opacity hover:opacity-90"
      >بحث</button
    >
  </form>

  <button
    type="button"
    id="order-toggle"
    class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-lg border border-border bg-surface px-3 text-sm text-muted transition-colors hover:text-fg"
  >
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 4v16m-3-3 3 3 3-3M17 20V4m-3 3 3-3 3 3"></path>
    </svg>
    <span class="sr-only">الترتيب: </span>
    <span id="order-label" aria-live="polite">الأقدم أولاً</span>
  </button>

  <ol id="lesson-list" class="mt-3 space-y-2">
    {
      videos.map((v) => (
        <li>
          <a
            href={`/v/${v.id}/`}
            class="card flex items-start gap-3 p-3 transition-colors hover:bg-surface-2"
          >
            <img
              src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`}
              alt=""
              width="320"
              height="180"
              loading="lazy"
              class="aspect-video w-28 shrink-0 rounded-lg object-cover sm:w-40"
            />
            <span class="min-w-0 flex-1">
              <span data-vt-title class="line-clamp-3 font-medium leading-relaxed">{v.title}</span>
              <span
                class="mt-1 block text-sm text-muted"
                set:html={withDigits(
                  [arabicDate(v.uploadDate), duration(v.duration)].filter(Boolean).join(' · '),
                )}
              />
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <script>
    // Reverses the DOM rather than the CSS: on a 293-lesson list, tab order and
    // screen-reader order have to keep matching the eye (WCAG 1.3.2).
    const orderLabel = document.getElementById('order-label')!
    const lessonList = document.getElementById('lesson-list')!
    let newestFirst = false
    document.getElementById('order-toggle')!.addEventListener('click', () => {
      lessonList.append(...[...lessonList.children].reverse())
      newestFirst = !newestFirst
      orderLabel.textContent = newestFirst ? 'الأحدث أولاً' : 'الأقدم أولاً'
    })
  </script>
</Base>
