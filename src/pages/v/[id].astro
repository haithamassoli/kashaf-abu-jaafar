---
import Base from '../../layouts/Base.astro'
import Player from '../../islands/Player'
import Cues from '../../components/Cues.astro'
import Actions from '../../components/Actions.astro'
import Note from '../../components/Note.astro'
import { videos, segmentsOf, playlistById, playlistVideos, type Video } from '../../lib/data'
import { arabicDate, duration, youtubeUrl } from '../../lib/format'
import { SITE, SITE_URL, person, breadcrumb } from '../../lib/seo'

export function getStaticPaths() {
  return videos.map((video) => ({ params: { id: video.id }, props: { video } }))
}

interface Props {
  video: Video
}

const { video } = Astro.props
const segments = segmentsOf(video.id)

const intro = segments
  .slice(0, 8)
  .map((s) => s.t)
  .join(' ')
const description = intro.length > 150 ? `${intro.slice(0, 150).trimEnd()}…` : intro

/** Wrap Western digit runs so they keep LTR order and tabular figures. */
const digits = (s: string) => s.replace(/\d+/g, '<span class="digits">$&</span>')

const total = Math.floor(video.duration)
const isoDuration = `PT${Math.floor(total / 3600)}H${Math.floor((total % 3600) / 60)}M${total % 60}S`

// ponytail: hqdefault is the only thumb size YouTube guarantees, so cards crop its
// 4:3 to 16:9. Switch to maxresdefault if we ever verify each id has one (many 404).
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  '@id': `${SITE_URL}/v/${video.id}/#video`,
  name: video.title,
  description: description || undefined,
  uploadDate: video.uploadDate ?? undefined,
  duration: isoDuration,
  url: new URL(`/v/${video.id}/`, SITE_URL).href,
  embedUrl: `https://www.youtube-nocookie.com/embed/${video.id}`,
  contentUrl: youtubeUrl(video.id),
  thumbnailUrl: [
    `https://i.ytimg.com/vi/${video.id}/mqdefault.jpg`,
    `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`,
  ],
  inLanguage: 'ar',
  author: person,
  // No `transcript` field: the Player island server-renders every cue, so the text is
  // already in the HTML — repeating it here would double a 32 KB page for nothing.
}

// Prev/next walk the first playlist only: 37 of 1,584 videos sit in more than one, so any
// pick is arbitrary, and one video sits in none — that one gets no nav.
const series = playlistById.get(video.playlists[0]?.id ?? '')
const siblings = series ? playlistVideos(series) : []
const at = siblings.findIndex((v) => v.id === video.id)
const prev = at > 0 ? siblings[at - 1] : undefined
const next = at >= 0 ? siblings[at + 1] : undefined

const crumbs = breadcrumb([['القوائم', '/p/'], [video.title, `/v/${video.id}/`]])
---

<Base
  wide
  title={video.title}
  description={description || undefined}
  image={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
  type="video.other"
  schema={[videoSchema, crumbs]}
>
  <div class="pt-8">
    {/* Series chips lead the row, share/download sit at the far end of the same line —
        and `ms-auto` keeps them there for the one video that belongs to no playlist. */}
    <div class="flex items-start gap-3">
      {video.playlists.length > 0 && (
        <nav aria-label="قوائم التشغيل" class="flex min-w-0 flex-wrap items-center gap-2">
          {video.playlists.map((p) => (
            <a
              href={`/p/${p.id}/`}
              class="inline-flex min-h-11 items-center rounded-full bg-surface-2 px-4 text-sm text-muted transition-colors hover:text-fg"
            >
              {p.title}
            </a>
          ))}
        </nav>
      )}

      <Actions title={video.title} kind="v" class="ms-auto shrink-0" />
    </div>

    <h1 class="mt-4 text-xl font-semibold leading-relaxed sm:text-2xl">{video.title}</h1>

    <div class="mt-1 flex flex-wrap items-center gap-x-5 text-sm text-muted">
      {video.uploadDate && <span set:html={digits(arabicDate(video.uploadDate))} />}
      <span set:html={digits(duration(video.duration))} />
      <a
        href={youtubeUrl(video.id)}
        rel="noopener"
        class="inline-flex min-h-11 items-center text-accent underline underline-offset-4"
        >افتح في يوتيوب</a
      >
      {/* Print drops the chrome, so paper needs the way back to the page it came from. */}
      <a
        href={`${SITE_URL}/v/${video.id}/`}
        class="hidden min-h-11 items-center text-accent underline underline-offset-4 print:inline-flex"
        >افتح في {SITE}</a
      >
    </div>
  </div>

  <div class="mt-6 grid items-start gap-6 lg:grid-cols-2 lg:gap-8">
    <!--
      client:load, not client:visible: the island no longer owns only the player — it also
      drives the whole server-rendered transcript (click-to-seek, filter, auto-follow).
      Measured on a mobile reload deep in the transcript: the <astro-island> wrapper itself
      has a zero-area, non-intersecting rect (the player inside it is sticky, so the wrapper
      collapses), and under client:visible the observer never fires — the transcript would
      stay inert with no seek and no filter.
    -->
    <Player client:load videoId={video.id} title={video.title} />

    <section aria-label="التفريغ" class="min-w-0">
      <div
        class="-mx-2 flex flex-wrap items-center gap-x-4 gap-y-2 bg-bg px-2 py-2 print:hidden lg:sticky lg:top-14 lg:z-20"
      >
        <input
          type="search"
          data-search-input
          placeholder="ابحث داخل الفيديو"
          aria-label="ابحث داخل الفيديو"
          class="h-11 min-w-0 flex-1 rounded-lg border border-border-strong bg-surface px-3 text-sm placeholder:text-muted"
        />
        <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 text-sm text-muted">
          <input type="checkbox" data-follow checked class="size-4 accent-accent" />
          متابعة تلقائية
        </label>
      </div>

      <p id="cue-count" class="min-h-6 pt-1 text-sm text-muted print:hidden"></p>
      <span id="cue-status" aria-live="polite" class="sr-only"></span>

      <a
        href="#after-transcript"
        class="sr-only focus:not-sr-only focus:mb-2 focus:inline-flex focus:h-11 focus:items-center focus:rounded-lg focus:bg-accent focus:px-4 focus:text-accent-fg"
        >تخطَّ التفريغ</a
      >

      <Cues segments={segments} />
      <div id="after-transcript" tabindex="-1" class="outline-none"></div>
    </section>
  </div>

  <Note title={video.title} kind="v" />

  {
    (prev || next) && (
      <nav aria-label="التنقّل بين الدروس" class="mt-10 border-t border-border pt-6 print:hidden">
        {series && (
          <p class="text-sm text-muted">
            من قائمة{' '}
            <a href={`/p/${series.id}/`} class="text-accent underline underline-offset-4">
              {series.title}
            </a>
          </p>
        )}

        {/* max-w-md is what leaves free space for justify-between to spread — without a cap
            the two cards fill the row and a lone one would never reach its side. */}
        <div class="mt-3 flex flex-wrap justify-between gap-3">
          {prev && (
            <a
              href={`/v/${prev.id}/`}
              class="card flex min-h-11 max-w-md flex-1 basis-64 items-center gap-3 px-4 py-3 transition-colors hover:bg-surface-2"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4 shrink-0 text-muted"
                aria-hidden="true"
              >
                <path d="M9 6l6 6-6 6" />
              </svg>
              <span class="min-w-0">
                <span class="block text-sm text-muted">الدرس السابق</span>
                <span class="line-clamp-2 text-sm font-medium leading-relaxed">{prev.title}</span>
              </span>
            </a>
          )}

          {next && (
            <a
              href={`/v/${next.id}/`}
              class="card ms-auto flex min-h-11 max-w-md flex-1 basis-64 items-center gap-3 px-4 py-3 transition-colors hover:bg-surface-2"
            >
              <span class="min-w-0 grow text-end">
                <span class="block text-sm text-muted">الدرس التالي</span>
                <span class="line-clamp-2 text-sm font-medium leading-relaxed">{next.title}</span>
              </span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4 shrink-0 text-muted"
                aria-hidden="true"
              >
                <path d="M15 6l-6 6 6 6" />
              </svg>
            </a>
          )}
        </div>
      </nav>
    )
  }
</Base>
