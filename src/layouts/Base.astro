---
// Font CSS must be imported here, not @import-ed from global.css: Tailwind's Vite
// plugin inlines @import without rewriting url(), which drops the woff2 files.
import '@fontsource-variable/noto-naskh-arabic/wght.css'
import '../styles/global.css'
import { SITE, SHEIKH } from '../lib/seo'
import JsonLd from '../components/JsonLd.astro'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
  wide?: boolean
  /** Absolute or root-relative; falls back to the site card. */
  image?: string
  /** Open Graph type — lesson pages are video.other, everything else website. */
  type?: 'website' | 'video.other'
  /** JSON-LD for this page; rendered in <head> so it can't land before the doctype. */
  schema?: Record<string, unknown>[]
}

const {
  title,
  description = `ابحث في دروس ${SHEIKH}`,
  noindex = false,
  wide = false,
  // Homepage screenshot at 1200×630. Regenerate against a running dev server:
  //   agent-browser set viewport 1200 630 && agent-browser open http://localhost:4321/
  //   agent-browser eval "scrollTo(0,36)" && agent-browser screenshot public/og.png
  image = '/og.png',
  type = 'website',
  schema = [],
} = Astro.props

// Simple Icons paths (24×24, filled).
const social = [
  {
    label: 'تيليجرام',
    href: 'https://t.me/alkulife',
    d: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z',
  },
  {
    label: 'يوتيوب',
    href: 'https://www.youtube.com/@Alkulify1',
    d: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
  {
    label: 'فيسبوك',
    href: 'https://www.facebook.com/alkulify',
    d: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  },
  {
    label: 'إكس',
    href: 'https://x.com/Xalkulify',
    d: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z',
  },
]
const fullTitle = title ? `${title} — ${SITE}` : SITE
const base = Astro.site ?? Astro.url.origin
const canonical = new URL(Astro.url.pathname, base).href
const ogImage = new URL(image, base).href
// Only the site card's dimensions are known ahead of time; YouTube thumbs are 480×360.
const ogSize = image === '/og.png' ? { w: '1200', h: '630' } : { w: '480', h: '360' }
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title ?? SITE} />
    <meta property="og:image:width" content={ogSize.w} />
    <meta property="og:image:height" content={ogSize.h} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101210" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {schema.map((data) => <JsonLd data={data} />)}
    <script is:inline>
      // Applied before first paint so the theme never flashes.
      try {
        const saved = localStorage.getItem('theme')
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.classList.toggle('dark', dark)
      } catch {}
    </script>
  </head>

  <body class="bg-bg text-fg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg"
      >تخطَّ إلى المحتوى</a
    >

    <header class="sticky top-0 z-30 border-b border-border bg-bg">
      <div
        class:list={[
          'mx-auto flex h-14 items-center justify-between gap-3 px-4',
          wide ? 'max-w-6xl' : 'max-w-3xl',
        ]}
      >
        <a href="/" class="-ms-2 flex h-11 items-center gap-2 rounded-lg px-2 text-base font-semibold tracking-tight">
          <svg
            class="size-5 text-accent"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="m15.5 15.5 4.5 4.5" stroke-linecap="round"></path>
          </svg>
          <span>{SITE}</span>
        </a>

        <nav class="flex items-center gap-1 text-sm" aria-label="روابط رئيسية">
          <a
            href="/p/"
            class="inline-flex h-11 items-center rounded-lg px-3 text-muted transition-colors hover:bg-surface-2 hover:text-fg"
            >القوائم</a
          >
          <button
            type="button"
            id="theme-toggle"
            class="grid size-11 place-items-center rounded-lg text-muted transition-colors hover:bg-surface-2 hover:text-fg"
            aria-pressed="false"
            aria-label="الوضع الداكن"
          >
            <svg
              class="size-5 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"></path>
            </svg>
            <svg
              class="hidden size-5 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class:list={['mx-auto px-4 pb-24', wide ? 'max-w-6xl' : 'max-w-3xl']}>
      <slot />
    </main>

    <footer class="border-t border-border">
      <div
        class:list={[
          'mx-auto px-4 py-8 text-center text-sm text-muted',
          wide ? 'max-w-6xl' : 'max-w-3xl',
        ]}
      >
        <ul class="flex items-center justify-center gap-1">
          {
            social.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={s.label}
                  class="grid size-11 place-items-center rounded-lg text-muted transition-colors hover:bg-surface-2 hover:text-fg"
                >
                  <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={s.d} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="mt-4">كشّاف غير رسمي لدروس الشيخ أبي جعفر عبد الله بن فهد الخليفي.</p>
        <p class="mt-1">
          النصوص مفرَّغة آليًا وقد تحتوي أخطاء؛ الأصل هو
          <a
            href="https://www.youtube.com/@Alkulify1"
            class="text-accent underline underline-offset-4"
            rel="noopener">التسجيل الصوتي</a
          >.
        </p>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById('theme-toggle')
      const syncToggle = () =>
        toggle?.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')))
      syncToggle()
      toggle?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark')
        syncToggle()
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light')
        } catch {}
      })

      // "/" focuses the page's search box, unless the user is already typing.
      addEventListener('keydown', (e) => {
        if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return
        const el = document.activeElement
        if (
          el instanceof HTMLInputElement ||
          el instanceof HTMLTextAreaElement ||
          el instanceof HTMLSelectElement ||
          (el instanceof HTMLElement && el.isContentEditable)
        )
          return
        const box = document.querySelector('[data-search-input]')
        if (box instanceof HTMLInputElement) {
          e.preventDefault()
          box.focus()
          box.select()
        }
      })
    </script>
  </body>
</html>
