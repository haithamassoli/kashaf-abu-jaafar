{
	order rate_limit before basicauth
}

search.assoli.site {
	# The search key is public — it ships inside the JS bundle — so this block is the only thing
	# between it and a box with one core that also runs Ollama. One search is 2–4 requests, so 30
	# leaves room for a reader on a shared carrier IP and none for a script.
	rate_limit {
		zone search {
			# The preflight must never be the request that gets refused. A browser never shows JS
			# the response to a failed OPTIONS, so a refused preflight arrives as «Failed to fetch»
			# — indistinguishable from a dead box, and meili.ts answers that by retrying twice.
			# Preflights are cached for 24 h and never reach the index; the POST behind them is
			# what this zone is for. ponytail: OPTIONS is left unlimited, which is fine while it
			# stays a CORS reply Meilisearch answers without searching anything.
			#
			# Search paths only. Everything else on this port — /tasks, /indexes/*/documents,
			# /settings, /stats — is master-key-only, so throttling it protects nothing and
			# does break the one thing that uses it: `scripts/index.ts` run from the laptop,
			# whose waitForTask poll spends the whole budget in under two seconds.
			match {
				not method OPTIONS
				path /multi-search /indexes/*/search /indexes/*/facet-search /indexes/*/similar
			}
			key {remote_host}
			events 30
			window 10s
		}
	}

	reverse_proxy 127.0.0.1:7700

	# Meilisearch answers cross-origin; Caddy's own 429 would not, and a CORS-blocked reply reaches
	# the browser as a network error rather than a status — which src/lib/meili.ts reads as a dead
	# embedder and retries twice. Making the refusal readable is what stops it tripling the load.
	handle_errors 429 {
		header Access-Control-Allow-Origin *
		header Content-Type application/json
		respond `{"message":"too many requests","code":"rate_limited"}` 429
	}
}
